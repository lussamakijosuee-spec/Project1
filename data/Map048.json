lse,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterName":"Actor1","direction":2,"pattern":1,"characterIndex":0,"tileId":0},"list":[{"code":223,"indent":0,"parameters":[[17,8,-20,17],90,true]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Au bord d'un sanctuaire en ruine, un homme regarde l'horizon."]},{"code":401,"indent":0,"parameters":["Il ne se retourne pas tout de suite."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\C[14]?\\C[0] : « Beau, n'est-ce pas ? Ce monde. Même brisé."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Surtout brisé, peut-être. On voit mieux ce qui tenait,"]},{"code":401,"indent":0,"parameters":["une fois que c'est cassé. »"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Il se retourne. Ses yeux — il est impossible de soutenir"]},{"code":401,"indent":0,"parameters":["leur regard plus d'une seconde."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\C[14]Donovano\\C[0] : « On m'appelle le Second. Second après un dieu"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["qui est parti sans un mot. C'est un drôle de titre :"]},{"code":401,"indent":0,"parameters":["être le plus fort d'un monde que le premier a abandonné. »"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["« Je te regarde depuis un moment. Tu portes les trois sources"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["en tension — comme moi. La plupart choisissent une voie,"]},{"code":401,"indent":0,"parameters":["et tombent. Toi, tu tiens. C'est rare. C'est dangereux. »"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["« La force n'a jamais suffi à personne. Le Premier était"]},{"code":401,"indent":0,"parameters":["le plus fort de tous — et regarde : un trône vide, et nous"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["qui prions une absence. Ce qui compte, ce n'est pas"]},{"code":401,"indent":0,"parameters":["ce que tu peux briser. C'est ce que tu choisis de porter. »"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Un petit être de lumière se pose sur son épaule."]},{"code":401,"indent":0,"parameters":["\\C[14]Donovano\\C[0] : « …Emy trouve que je parle trop. »"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["« Alors montre-moi, plutôt que je t'explique."]},{"code":401,"indent":0,"parameters":["Un échange. Pas une menace — une mesure. Es-tu prêt ? »"]},{"code":102,"indent":0,"parameters":[["Se mesurer au Second.","Décliner — pas aujourd'hui."],-2,0,2,0]},{"code":402,"indent":0,"parameters":[0,"Se mesurer au Second."]},{"code":241,"indent":1,"parameters":[{"name":"Battle2","volume":90,"pitch":100,"pan":0}]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["\\C[14]Donovano\\C[0] : « Bien. Ne retiens rien."]},{"code":401,"indent":1,"parameters":["Moi… je vais essayer de me retenir un peu. »"]},{"code":224,"indent":1,"parameters":[[255,255,220,160],30,true]},{"code":301,"indent":1,"parameters":[0,517,true,true]},{"code":601,"indent":1,"parameters":[]},{"code":101,"indent":2,"parameters":["",0,0,2]},{"code":401,"indent":2,"parameters":["\\C[14]Donovano\\C[0] tombe sur un genou, stupéfait —"]},{"code":401,"indent":2,"parameters":["puis il rit, franchement, pour la première fois."]},{"code":101,"indent":2,"parameters":["",0,0,2]},{"code":401,"indent":2,"parameters":["« …Tu m'as touché. TU m'as touché. Sais-tu depuis"]},{"code":401,"indent":2,"parameters":["combien d'années personne n'y était parvenu ? »"]},{"code":101,"indent":2,"parameters":["",0,0,2]},{"code":401,"indent":2,"parameters":["« Garde ceci. Un éclat de mon mana semi-parfait."]},{"code":401,"indent":2,"parameters":["Il perce ce qui résiste. Tu sauras quoi en faire. »"]},{"code":356,"indent":2,"parameters":["CHRONIQUE note Le_Second_a_ete_touche._Le_monde_ne_le_sait_pas_encore."]},{"code":355,"indent":2,"parameters":["if(window.Rangs)0;"]},{"code":602,"indent":1,"parameters":[]},{"code":101,"indent":2,"parameters":["",0,0,2]},{"code":401,"indent":2,"parameters":["Tu recules. \\C[14]Donovano\\C[0] ne te poursuit pas."]},{"code":401,"indent":2,"parameters":["« Sage. Fuir un mur, ce n'est pas de la lâcheté."]},{"code":101,"indent":2,"parameters":["",0,0,2]},{"code":401,"indent":2,"parameters":["C'est savoir compter. Reviens quand tu compteras"]},{"code":401,"indent":2,"parameters":["plus haut. »"]},{"code":603,"indent":1,"parameters":[]},{"code":223,"indent":2,"parameters":[[-60,-60,-40,80],20,true]},{"code":101,"indent":2,"parameters":["",0,0,2]},{"code":401,"indent":2,"parameters":["Tu n'as rien vu venir. Pas un coup — une évidence."]},{"code":401,"indent":2,"parameters":["Comme si le combat était déjà écrit, et perdu, avant de commencer."]},{"code":101,"indent":2,"parameters":["",0,0,2]},{"code":401,"indent":2,"parameters":["\\C[14]Donovano\\C[0] rengaine sans t'achever."]},{"code":401,"indent":2,"parameters":["« Debout. Je n'avais pas dégainé pour de vrai. »"]},{"code":101,"indent":2,"parameters":["",0,0,2]},{"code":401,"indent":2,"parameters":["« Ce n'est pas une humiliation. C'est une distance."]},{"code":401,"indent":2,"parameters":["Tu la combleras, ou tu tomberas avant. »"]},{"code":101,"indent":2,"parameters":["",0,0,2]},{"code":401,"indent":2,"parameters":["« Le Premier disait qu'un mur n'existe que pour être"]},{"code":401,"indent":2,"parameters":["escaladé. …Il est parti sans nous montrer comment. »"]},{"code":223,"indent":2,"parameters":[[0,0,0,0],30,false]},{"code":604,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[1,"Décliner — pas aujourd'hui."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["\\C[14]Donovano\\C[0] hoche la tête, sans jugement."]},{"code":401,"indent":1,"parameters":["« Il y a plus de courage à décliner qu'à perdre bêtement."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["Je serai là. Le horizon ne bouge pas vite. »"]},{"code":404,"indent":0,"parameters":[]},{"code":241,"indent":0,"parameters":[{"name":"Theme6","volume":90,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\C[14]Donovano\\C[0] se retourne vers l'horizon."]},{"code":401,"indent":0,"parameters":["« Va. Et tiens les trois. C'est tout ce qui compte. »"]},{"code":121,"indent":0,"parameters":[70,70,0]},{"code":123,"indent":0,"parameters":["A",0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterName":"Actor1","direction":2,"pattern":1,"characterIndex":0,"tileId":0},"list":[{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Le sanctuaire est vide. Sur la pierre, un éclat de lumière"]},{"code":401,"indent":0,"parameters":["s'attarde encore, à hauteur d'épaule — puis s'éteint."]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}]}]}